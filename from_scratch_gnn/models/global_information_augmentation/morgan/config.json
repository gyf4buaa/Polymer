{
  "experiment_id": "own_gnn_stage4a_morgan",
  "model_name": "Own-GNN Stage 4A — Morgan fingerprint",
  "category": "own_model",
  "benchmark_version": "nopp2025_train_v1",
  "seed": 42,
  "graph": {
    "schema": "own_gnn_repr_keep_dummy_raw_graph_node7_edge16_endpoint1_v1",
    "representation": "keep_dummy",
    "node_features": [
      "atomic_number",
      "degree",
      "formal_charge",
      "hybridization",
      "aromatic",
      "total_hydrogens",
      "chirality"
    ],
    "additional_node_features": [
      "polymer_endpoint_all_zero"
    ],
    "atomic_number_zero_bucket": 0,
    "edge_features": [
      "bond_type_one_hot",
      "conjugated",
      "in_ring",
      "stereo_one_hot",
      "polymerization_edge_all_zero"
    ],
    "dummy_policy": "retain_all_source_atoms_and_rdkit_chemical_bonds",
    "endpoint_closure": false,
    "ambiguous_dummy_policy": "retain_complete_source_graph_without_fallback"
  },
  "model": {
    "operator": "GINEConv",
    "hidden_dim": 256,
    "num_layers": 4,
    "dropout": 0.1,
    "residual": true,
    "normalization": "LayerNorm",
    "pooling": [
      "global_mean",
      "global_max"
    ],
    "property_heads": [
      "Tg",
      "FFV",
      "Tc",
      "Density",
      "Rg"
    ],
    "endpoint_indicator_embedding": "zero_initialized_additive_vector; input is all zero",
    "global_information": {
      "variant": "M",
      "source": "binary Morgan fingerprint from raw benchmark SMILES",
      "radius": 2,
      "bit_count": 2048,
      "chirality": true,
      "input_dim": 2048,
      "standardization": "none",
      "target_based_selection": false,
      "fusion": "z_graph + Linear(2048, 512, bias=False)(x_M)",
      "projection_initialization": "all_zero"
    }
  },
  "training": {
    "epochs_max": 600,
    "patience": 40,
    "batch_size": 64,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "loss": "masked_huber",
    "huber_delta": 1.0,
    "target_normalization": "fold_train_mean_std",
    "task_reduction": "equal_mean_over_tasks_with_observed_labels",
    "early_stopping_metric": "Stage0 weighted MAE with frozen manifest weights"
  },
  "registry_notes": "Stage 4A global-information augmentation; frozen keep-dummy GINE/R0 graph path, training settings, folds, target normalization, and metric; zero-initialized linear residual after mean+max graph readout."
}
